# Docker Compose (dev) — Postgres container credentials; the api's DATABASE_URL is built from these.
POSTGRES_USER=copilot
POSTGRES_DB=copilot

# Export the API's own traces, metrics and logs to the LGTM stack (Grafana at http://localhost:3000).
TELEMETRY_TRACES_ENABLED=true

# Secrets
POSTGRES_PASSWORD=copilot
