# Connection URLs for the database, Redis, the monitoring stack and the demo deployment backend, and the
# API's own telemetry settings, are injected by docker-compose.dev.yaml.

LOG_LEVEL=DEBUG

# LLM — any LangChain-supported provider (openai, anthropic, ollama, …).
# Defaults target a local Ollama on the host: `ollama pull qwen3:8b`.
LLM_PROVIDER=ollama
LLM_MODEL=qwen3:8b
# Optional; defaults to LLM_MODEL.
LLM_CLASSIFIER_MODEL=
# Optional; for self-hosted or OpenAI-compatible servers.
LLM_BASE_URL=http://host.docker.internal:11434

# Embeddings — EMBEDDING_DIMENSIONS must match the model's output size.
# Defaults target a local Ollama on the host: `ollama pull nomic-embed-text`.
EMBEDDING_PROVIDER=ollama
EMBEDDING_MODEL=nomic-embed-text
EMBEDDING_DIMENSIONS=768
EMBEDDING_BASE_URL=http://host.docker.internal:11434

# Secrets
# Optional for keyless providers such as Ollama.
LLM_API_KEY=
EMBEDDING_API_KEY=
# Dev-only value; at least 32 characters. Generate real ones with `openssl rand -hex 32`.
AUTH_JWT_SECRET=dev-only-insecure-jwt-secret-change-me-0000
