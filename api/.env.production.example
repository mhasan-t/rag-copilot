LOG_LEVEL=INFO

# Database / cache
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
REDIS_URL=redis://<host>:6379/0

# Monitoring stack
PROMETHEUS_URL=http://<prometheus-host>:9090
LOKI_URL=http://<loki-host>:3100
TEMPO_URL=http://<tempo-host>:3200

# Deployment control: demo (the demo payments service) or kubernetes.
DEPLOYMENT_BACKEND=kubernetes
# Required when DEPLOYMENT_BACKEND=demo.
DEMO_PAYMENTS_ADMIN_URL=
# For DEPLOYMENT_BACKEND=kubernetes: the namespace whose Deployments the copilot may change (required), and whether
# to use the pod's service account (true) or the local kubeconfig (false).
KUBERNETES_NAMESPACE=<namespace>
KUBERNETES_IN_CLUSTER=true

# The API's own traces, metrics and logs, sent over OTLP/HTTP.
TELEMETRY_TRACES_ENABLED=true
# Required when TELEMETRY_TRACES_ENABLED=true; the collector's OTLP/HTTP base URL (port 4318 by default).
OTEL_EXPORTER_OTLP_ENDPOINT=http://<otel-collector-host>:4318

# LLM — any LangChain-supported provider (openai, anthropic, ollama, …).
LLM_PROVIDER=<provider>
LLM_MODEL=<model>
# Optional; defaults to LLM_MODEL.
LLM_CLASSIFIER_MODEL=
# Optional; for self-hosted or OpenAI-compatible servers.
LLM_BASE_URL=

# Embeddings — EMBEDDING_DIMENSIONS must match the model's output size.
EMBEDDING_PROVIDER=<provider>
EMBEDDING_MODEL=<model>
EMBEDDING_DIMENSIONS=<dimensions>
EMBEDDING_BASE_URL=

# Secrets
LLM_API_KEY=<llm provider api key>
EMBEDDING_API_KEY=<embedding provider api key>
# At least 32 characters; generate with `openssl rand -hex 32`.
AUTH_JWT_SECRET=<random secret>
