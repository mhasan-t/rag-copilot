LOG_LEVEL=INFO

# Database / cache
DATABASE_URL=postgresql+asyncpg://<user>:<password>@<host>:5432/<database>
REDIS_URL=redis://<host>:6379/0

# LLM — any LangChain-supported provider (openai, anthropic, ollama, …).
LLM_PROVIDER=<provider>
LLM_MODEL=<model>
# Optional; defaults to LLM_MODEL.
LLM_CLASSIFIER_MODEL=
# Optional; for self-hosted or OpenAI-compatible servers.
LLM_BASE_URL=

# Embeddings — EMBEDDING_DIMENSIONS must match the model's output size.
EMBEDDING_PROVIDER=<provider>
EMBEDDING_MODEL=<model>
EMBEDDING_DIMENSIONS=<dimensions>
EMBEDDING_BASE_URL=

# Secrets
LLM_API_KEY=<llm provider api key>
EMBEDDING_API_KEY=<embedding provider api key>
