{
  "uid": "copilot",
  "title": "Copilot",
  "schemaVersion": 39,
  "version": 1,
  "tags": [
    "rag-copilot"
  ],
  "time": {
    "from": "now-6h",
    "to": "now"
  },
  "refresh": "30s",
  "panels": [
    {
      "id": 1,
      "type": "timeseries",
      "title": "Runs by outcome",
      "description": "Runs reaching each status, per 5 minutes",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (status) (increase(copilot_runs_total[5m]))",
          "legendFormat": "{{status}}"
        }
      ]
    },
    {
      "id": 2,
      "type": "timeseries",
      "title": "Remediation events",
      "description": "Proposals, decisions and outcomes. Rising 'unverified' or 'failed' needs attention.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (event, risk) (increase(copilot_remediation_events_total[5m]))",
          "legendFormat": "{{event}} ({{risk}} risk)"
        }
      ]
    },
    {
      "id": 3,
      "type": "timeseries",
      "title": "Step errors",
      "description": "Failed graph nodes, evidence queries and LLM calls. An evidence source failing doesn't fail the run.",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 0
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (node, tool) (increase(copilot_step_duration_milliseconds_count{error=\"true\"}[5m]))",
          "legendFormat": "{{node}} {{tool}}"
        }
      ]
    },
    {
      "id": 4,
      "type": "timeseries",
      "title": "Node latency p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 0,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, node) (rate(copilot_step_duration_milliseconds_bucket{tool=\"\"}[5m])))",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "LLM call latency p95",
      "description": "",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "ms",
          "custom": {
            "drawStyle": "line"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.95, sum by (le, node) (rate(copilot_step_duration_milliseconds_bucket{tool=\"llm\"}[5m])))",
          "legendFormat": "{{node}}"
        }
      ]
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "LLM tokens per minute",
      "description": "Only for providers that report usage",
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 16,
        "y": 8
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line"
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (node, type) (rate(copilot_llm_tokens_total[5m])) * 60",
          "legendFormat": "{{node}} {{type}}"
        }
      ]
    },
    {
      "id": 7,
      "type": "table",
      "title": "Recent runs (open one to see every step)",
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "tempo",
            "uid": "tempo"
          },
          "queryType": "traceql",
          "limit": 20,
          "query": "{resource.service.name=\"rag-copilot-api\" && name=~\"copilot.run|copilot.resume\"}"
        }
      ]
    },
    {
      "id": 8,
      "type": "logs",
      "title": "Warnings and errors",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "h": 9,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service_name=\"rag-copilot-api\"} | severity_text=~\"WARN|WARNING|ERROR|CRITICAL\""
        }
      ]
    }
  ]
}