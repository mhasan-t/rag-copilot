server {
    listen 8080;
    root /usr/share/nginx/html;

    location /v1/ {
        proxy_pass ${API_UPSTREAM};
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        # Asking the copilot waits for the LLM; give it as long as the API's own LLM timeouts allow.
        proxy_read_timeout 300s;
    }

    # Hashed file names never change content, so they can be cached forever.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Client-side routes (/runs/..., /approvals) all load the app; index.html itself is never cached.
    location / {
        add_header Cache-Control "no-cache";
        try_files $uri /index.html;
    }
}
